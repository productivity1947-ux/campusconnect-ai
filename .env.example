# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional server-only allowlist for private admin provisioning; comma-separated verified emails.
CAMPUS_ADMIN_EMAILS=

# Prisma
# Runtime only: non-owner campusconnect_runtime role from prisma/runtime-role-setup.sql.
# Copy the exact runtime-role username and pooler host from the Supabase Dashboard.
# Keep both URLs server-only; never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://[runtime-pooler-username]:[password]@[pooler-host]:6543/postgres?pgbouncer=true
# Prisma CLI/migrations only: administrative connection; never use for runtime queries.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres
# Optional relative or absolute override; defaults to the bundled official CA file.
SUPABASE_CA_CERT_PATH=certs/supabase-prod-ca-2021.crt

# Google Gemini
GEMINI_API_KEY=
